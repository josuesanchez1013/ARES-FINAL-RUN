# ARES Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Genesis API Token (from Genesis > Tokens page)
# Use a Member token for runtime agent calls.
GENESIS_API_TOKEN=your-genesis-token-here

# Genesis API address. REQUIRED for real (non-mock) runs: the code no longer ships a default host.
GENESIS_API_URL=

# Genesis Organization (optional — only needed if using a personal token to access another org)
GENESIS_ORG=

# Agent IDs (from Genesis > Build > Agents or Discover > Agent Catalog)
ARES_PARSER_AGENT_ID=d708cb3a-b2a9-49ae-a147-ebe8ad7af173
GAP_COVERAGE_AGENT_ID=
DETERMINATION_AGENT_ID=
REPORTING_AGENT_ID=

# Set to "false" to call real Genesis agents instead of mock data
ARES_USE_MOCK=true

# SSL cert bundle (corporate environments with internal CA)
# On corporate Windows machines this is typically: C:\users\<user>\certs\Combined_pem.pem
SSL_CERT_FILE=

# SSH Config for CLI Executor (used by Gap Coverage + Determination agents)
SSH_HOST=10.0.2.15
SSH_USER=ares
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_PORT=22

# MCP server used by the parser step. Required for real runs in UI v2: if it is
# empty, a UI v2 run stops at the model check instead of falling back to the
# retired OpenShift server.
MCP_SERVER_URL=

# UI v2 (ares_api). All optional; defaults are listed in README_UI_V2.md.
# ARES_LLM_MODELS=nemotron-3-ultra-550b-a55b
# ARES_SENSITIVITY_CATEGORIES=PII,Proprietary,Export controlled,Other
# ARES_DATA_DIR=data/runs
# ARES_RUN_RETENTION=50
# ARES_STIG_LIBRARY_DIR=data/stig_library
# ARES_STIG_IMPORT_MAX_MB=2048
# ARES_TARGETS_DIR=data/targets
# ARES_SCAP_DIR=data/scap_scans
# Passwords for saved targets: any variable name you enter on the Targets page, for example
# ARES_PW_WEB01=
# ARES_TARGET_HOST=rhel8-stig-lab
# ARES_TARGET_IP=10.0.2.15
